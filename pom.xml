<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.3</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>pdf-signer-desktop</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>pdf-signer-desktop</name>
    <description>
        Local desktop PDF digital-signature application built around a generic
        PKCS#11 hardware cryptographic token, with sequential multi-signer
        workflows and chain-aware signature verification.
    </description>

    <properties>
        <java.version>21</java.version>
        <javafx.version>21.0.7</javafx.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- source/target instead of the release flag, deliberately: javac
             rejects the jdk.crypto.cryptoki add-exports together with the
             release flag (verified empirically), and compiling against
             sun.security.pkcs11.wrapper requires that export. The empty
             release below overrides the Boot parent's maven.compiler.release
             default (${java.version}). The resulting "location of system
             modules" warning is the known, accepted trade-off; class files
             are exercised on JDK 21 in CI. -->
        <maven.compiler.release></maven.compiler.release>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Server-coordinated (REMOTE) signing mode: embedded coordination
             server. The desktop context itself stays WebApplicationType.NONE;
             the server runs as a separate Spring profile/process. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- PostgreSQL persistence (Phase 1 of the platform upgrade): JPA +
             Flyway migrations. ALL database beans are gated on
             signer.remote-server.database.enabled so the desktop context
             (WebApplicationType.NONE, no DataSource) is never affected and
             the file-based server mode keeps working unchanged. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Optional SMTP delivery for invitation emails (console delivery
             is the default; SMTP credentials come from environment only). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Security (Phase 2): Spring Security enforces authentication on
             every server request and validates JWT access tokens with its
             OAuth2 resource-server support (Nimbus). spring-security-crypto
             (BCrypt) comes with it. Versions are managed by Spring Boot. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <!-- Security Phase C: website sessions stored in PostgreSQL, so they
             survive a restart and work with several server instances. Only
             the coordination server in database mode wires this up
             (server.web.WebSessionConfiguration); the desktop context and
             file mode never see it. -->
        <dependency>
            <groupId>org.springframework.session</groupId>
            <artifactId>spring-session-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-swing</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-javafx</artifactId>
            <version>12.3.1</version>
        </dependency>
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-fontawesome5-pack</artifactId>
            <version>12.3.1</version>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
            <version>1.80</version>
        </dependency>

        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.5</version>
            <exclusions>
                <!-- Spring's spring-core already provides the
                     org.apache.commons.logging bridge routed to the app's
                     logback; keeping this jar would emit the
                     "Standard Commons Logging discovery" conflict warning. -->
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Workflow manifest (de)serialisation: manifests embedded in PDFs
             are untrusted input, so parsing uses a hardened, schema-controlled
             reader (see WorkflowManifestCodec) rather than a hand-rolled one. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Same resource handling as spring-boot-starter-parent (which this
             block replaces), plus signflow-build.properties: filtered with
             '@' delimiters so the desktop app knows its own version
             (Phase B remediation M2). Nothing else changes. -->
        <resources>
            <resource>
                <directory>${basedir}/src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>**/application*.yml</include>
                    <include>**/application*.yaml</include>
                    <include>**/application*.properties</include>
                    <include>signflow-build.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>${basedir}/src/main/resources</directory>
                <excludes>
                    <exclude>**/application*.yml</exclude>
                    <exclude>**/application*.yaml</exclude>
                    <exclude>**/application*.properties</exclude>
                    <exclude>signflow-build.properties</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <!-- "java -jar" reads Add-Exports from the manifest (Spring
                     Boot's repackage keeps these entries): the smart-card
                     certificate reads use the JDK PKCS#11 wrapper
                     (see Pkcs11WrapperAccess). -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Add-Exports>jdk.crypto.cryptoki/sun.security.pkcs11.wrapper</Add-Exports>
                            <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Desktop is the main artifact. The coordination server
                         runs from the same jar with the server profile (see
                         WorkflowServerApplication). -->
                    <mainClass>com.example.signer.SignerApplication</mainClass>
                    <!-- javafx:run is a development launch: mock token, plain
                         HTTP to a local server (profile 'dev'). -->
                    <commandlineArgs>--spring.profiles.active=dev</commandlineArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-XX:+EnableDynamicAgentLoading --add-modules jdk.crypto.cryptoki --add-exports jdk.crypto.cryptoki/sun.security.pkcs11.wrapper=ALL-UNNAMED</argLine>
                    <!-- Tests run with the 'dev' profile (src/test/resources);
                         keep the per-installation mock-token keys inside
                         target/ instead of the developer's home directory. -->
                    <environmentVariables>
                        <SIGNER_MOCK_TOKEN_KEYSTORE>${project.build.directory}/test-mock-token.p12</SIGNER_MOCK_TOKEN_KEYSTORE>
                    </environmentVariables>
                    <!-- Lets AppVersionTests check the filtered build version. -->
                    <systemPropertyVariables>
                        <signflow.expected.version>${project.version}</signflow.expected.version>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- release is intentionally left empty (see properties) to keep
                         system-module add-exports; skip the package-info generation
                         that would try to parse the empty release as an opcode. -->
                    <createMissingPackageInfoClass>false</createMissingPackageInfoClass>
                    <compilerArgs>
                        <!-- The [options] note below ("release is recommended
                             instead of source/target") is unavoidable here: the
                             cryptoki add-exports are rejected under the release
                             flag (verified empirically), and the trade-off is
                             documented in the properties block above. -->
                        <arg>-Xlint:-options</arg>
                        <arg>--add-modules</arg>
                        <arg>jdk.crypto.cryptoki</arg>
                        <arg>--add-exports</arg>
                        <arg>jdk.crypto.cryptoki/sun.security.pkcs11.wrapper=ALL-UNNAMED</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.example.signer.SignerApplication</mainClass>
                    <options>
                        <option>--add-modules</option>
                        <option>jdk.crypto.cryptoki</option>
                        <option>--add-exports</option>
                        <option>jdk.crypto.cryptoki/sun.security.pkcs11.wrapper=ALL-UNNAMED</option>
                        <option>--enable-native-access=javafx.graphics</option>
                    </options>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- JavaFX's marlin renderer calls sun.misc.Unsafe::allocateMemory,
             which JDK 23+ warns about (JEP 471). The flag below is the
             official escape hatch; it only exists on JDK 23+, so it is
             appended solely when the build runs on such a JDK. JDK 21 runs
             (CI) are unaffected and need nothing. -->
        <profile>
            <id>jdk23-unsafe-memory-access</id>
            <activation>
                <jdk>[23,)</jdk>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.openjfx</groupId>
                        <artifactId>javafx-maven-plugin</artifactId>
                        <version>0.0.8</version>
                        <configuration>
                            <!-- Full option set, not a delta: profile config
                                 replaces the base list (combine.self does not
                                 merge within the same POM, verified via
                                 help:effective-pom), so all base options are
                                 repeated here plus the unsafe-memory-access
                                 flag, which exists only on JDK 23+. -->
                            <options>
                                <option>--add-modules</option>
                                <option>jdk.crypto.cryptoki</option>
                                <option>--add-exports</option>
                                <option>jdk.crypto.cryptoki/sun.security.pkcs11.wrapper=ALL-UNNAMED</option>
                                <option>--enable-native-access=javafx.graphics</option>
                                <option>--sun-misc-unsafe-memory-access=allow</option>
                            </options>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>