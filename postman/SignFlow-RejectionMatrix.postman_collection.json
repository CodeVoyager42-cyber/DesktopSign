								"exec": [
									"pm.test(\"400 for a missing document name\", () => pm.response.to.have.status(400));",
									"pm.test(\"message says what is required\", () => {",
									"    pm.expect(pm.response.json().message).to.include(\"documentName\");",
									"});",
									"// Replaces the old 'unknown user' case, which can no longer be",
									"// expressed: the signer IS the authenticated caller, so there is",
									"// no user field to put a stranger in, and an authenticated caller",
									"// is a known account by definition. documentName is now the only",
									"// required field left in the create body."
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "request",
									"type": "text",
									"value": "{\"certificateSha256\":\"ABABABABABABABABABABABABABABABABABABABABABABABABABABABABABABABAB\"}"
								},
								{
									"key": "file",
									"type": "file",
									"src": "fixtures/original.pdf"
								}
							]
						},
						"url": {
							"raw": "{{baseUrl}}/api/workflows",
							"host": ["{{baseUrl}}"],
							"path": ["api", "workflows"]
						}
					},
					"response": []
				},
				{
					"name": "Enrol a certificate for someone else -> 403",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"403 - signer identity comes from the JWT, not the path\", () => pm.response.to.have.status(403));",
									"pm.test(\"WORKFLOW_NOT_ACCESSIBLE\", () => {",
									"    pm.expect(pm.response.json().code).to.eql(\"WORKFLOW_NOT_ACCESSIBLE\");",
									"});",
									"// Replaces the old 'forged identity' / order-gap case. Naming",
									"// another person as a signer is no longer possible, but the rule",
									"// it tested is: alice is signed in and asks to enrol a",
									"// certificate for bob. The controller compares the path user",
									"// against the JWT before any workflow is loaded, so this is 403",
									"// whatever state the document is in -- nobody can attach a card",
									"// to somebody else's slot."
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"certificateSha256\": \"ABABABABABABABABABABABABABABABABABABABABABABABABABABABABABABABAB\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/api/workflows/{{workflowId}}/signers/bob/certificate",
							"host": ["{{baseUrl}}"],
							"path": ["api", "workflows", "{{workflowId}}", "signers", "bob", "certificate"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "6. Idempotency + audit",
			"item": [
				{
					"name": "Audit trail shows every rejection",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"audit 200\", () => pm.response.to.have.status(200));",
									"const entries = pm.response.json();",
									"const types = entries.map(e => e.eventType);",
									"pm.test(\"stale revisions were audited\", () => {",
									"    pm.expect(types).to.include(\"STALE_REVISION_REJECTED\");",
									"});",
									"pm.test(\"tamper attempts were audited\", () => {",
									"    pm.expect(types).to.include(\"SIGNATURE_VALIDATION_FAILED\");",
									"});",
									"pm.test(\"rejections carry the actor identity\", () => {",
									"    const rejected = entries.filter(e => e.eventType === \"SIGNATURE_VALIDATION_FAILED\");",
									"    pm.expect(rejected.length).to.be.above(0);",
									"    pm.expect(rejected[0].actor).to.eql(\"alice\");",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/workflows/{{workflowId}}/audit",
							"host": ["{{baseUrl}}"],
							"path": ["api", "workflows", "{{workflowId}}", "audit"]
						}
					},
					"response": []
				},
