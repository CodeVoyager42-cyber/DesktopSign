package com.example.signer.server.api;

import com.example.signer.server.RemoteServerProperties;

import org.springframework.core.annotation.Order;
import org.springframework.stereotype.Component;
import org.springframework.web.filter.OncePerRequestFilter;

import java.io.IOException;
import java.nio.charset.StandardCharsets;
import java.util.Base64;

import jakarta.servlet.FilterChain;
import jakarta.servlet.ServletException;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;

/**
 * HTTP Basic authentication for the coordination API. Credentials come from
 * {@code signature.remote-server.users} (user → password); the authenticated
 * user id is injected as the {@link WorkflowRestController#USER_ATTR} request
 * attribute consumed by the controller.
 */
@Component
@Order(1)
public class BasicAuthFilter extends OncePerRequestFilter {

    private final RemoteServerProperties properties;

    public BasicAuthFilter(RemoteServerProperties properties) {
        this.properties = properties;
    }

    @Override
    protected boolean shouldNotFilter(HttpServletRequest request) {
        // Only the /api/workflows surface is served by this server.
        return !request.getRequestURI().startsWith("/api/workflows");
    }

    @Override
    protected void doFilterInternal(HttpServletRequest request,
                                    HttpServletResponse response,
                                    FilterChain chain)
            throws ServletException, IOException {
        String header = request.getHeader("Authorization");
        if (header == null || !header.startsWith("Basic ")) {
            unauthorized(response);
            return;
        }
        try {
            String decoded = new String(Base64.getDecoder().decode(
                    header.substring(6).trim()), StandardCharsets.UTF_8);
            int colon = decoded.indexOf(':');
            if (colon <= 0) {
                unauthorized(response);
                return;
            }
            String user = decoded.substring(0, colon);
            String password = decoded.substring(colon + 1);
            if (!properties.matches(user, password)) {
                unauthorized(response);
                return;
            }
            request.setAttribute(WorkflowRestController.USER_ATTR, user);
            chain.doFilter(request, response);
        } catch (IllegalArgumentException e) {
            unauthorized(response);
        }
    }

    private void unauthorized(HttpServletResponse response) throws IOException {
        response.setStatus(HttpServletResponse.SC_UNAUTHORIZED);
        response.setHeader("WWW-Authenticate", "Basic realm=\"signer-workflows\"");
        response.setContentType("application/json");
        response.getWriter().write(
                "{\"code\":\"UNAUTHORIZED\",\"message\":\"Authentication required\"}");
    }
}
